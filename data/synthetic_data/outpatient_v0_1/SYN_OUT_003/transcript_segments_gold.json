        "created_at": "2026-06-02T00:00:00+07:00",
        "version": "v0.1.0"
    },
    {
        "segment_id": "seg_003",
        "encounter_id": "SYN_OUT_003",
        "start_time": 6.6,
        "end_time": 10.0,
        "speaker_id": "Speaker_0",
        "speaker_role": "doctor",
        "text": "Anh \u0111au \u0111\u1ea7u ki\u1ec3u nh\u01b0 th\u1ebf n\u00e0o v\u00e0 \u0111au \u1edf \u0111\u00e2u?",
        "confidence": 1.0,
        "audio_span": {
            "start_time": 6.6,
            "end_time": 10.0
        },
        "created_at": "2026-06-02T00:00:00+07:00",
        "version": "v0.1.0"
    },
    {
        "segment_id": "seg_004",
        "encounter_id": "SYN_OUT_003",
        "start_time": 10.1,
        "end_time": 14.4,
        "speaker_id": "Speaker_1",
        "speaker_role": "patient",
        "text": "Em \u0111au \u00e2m \u1ec9 hai b\u00ean th\u00e1i d\u01b0\u01a1ng, kh\u00f4ng \u0111au d\u1eef d\u1ed9i.",
        "confidence": 1.0,
        "audio_span": {
            "start_time": 10.1,
            "end_time": 14.4
        },
        "created_at": "2026-06-02T00:00:00+07:00",
        "version": "v0.1.0"
    },
    {
        "segment_id": "seg_005",
        "encounter_id": "SYN_OUT_003",
        "start_time": 14.5,
        "end_time": 18.6,
        "speaker_id": "Speaker_0",
        "speaker_role": "doctor",
        "text": "C\u01a1n \u0111au c\u00f3 t\u0103ng d\u1ea7n l\u00ean kh\u00f4ng, hay xu\u1ea5t hi\u1ec7n \u0111\u1ed9t ng\u1ed9t kh\u00f4ng?",
        "confidence": 1.0,
        "audio_span": {
            "start_time": 14.5,
            "end_time": 18.6
        },
        "created_at": "2026-06-02T00:00:00+07:00",
        "version": "v0.1.0"
    },
    {
        "segment_id": "seg_006",
        "encounter_id": "SYN_OUT_003",
        "start_time": 18.7,
        "end_time": 22.5,
        "speaker_id": "Speaker_1",
        "speaker_role": "patient",
        "text": "D\u1ea1 kh\u00f4ng \u0111\u1ed9t ng\u1ed9t. N\u00f3 \u00e2m \u1ec9, l\u00fac t\u0103ng l\u00fac gi\u1ea3m.",
        "confidence": 1.0,
        "audio_span": {
            "start_time": 18.7,
            "end_time": 22.5
        },
        "created_at": "2026-06-02T00:00:00+07:00",
        "version": "v0.1.0"
    },
    {
        "segment_id": "seg_007",
        "encounter_id": "SYN_OUT_003",
        "start_time": 22.6,
        "end_time": 27.1,
        "speaker_id": "Speaker_0",
        "speaker_role": "doctor",
        "text": "Anh c\u00f3 bu\u1ed3n n\u00f4n, nh\u00ecn m\u1edd, n\u00f3i kh\u00f3 ho\u1eb7c y\u1ebfu li\u1ec7t tay ch\u00e2n kh\u00f4ng?",
        "confidence": 1.0,
        "audio_span": {
            "start_time": 22.6,
            "end_time": 27.1
        },
        "created_at": "2026-06-02T00:00:00+07:00",
        "version": "v0.1.0"
    },
    {
        "segment_id": "seg_008",
        "encounter_id": "SYN_OUT_003",
        "start_time": 27.2,
        "end_time": 32.0,
        "speaker_id": "Speaker_1",
        "speaker_role": "patient",
        "text": "D\u1ea1 kh\u00f4ng, em kh\u00f4ng nh\u00ecn m\u1edd, kh\u00f4ng n\u00f3i kh\u00f3 v\u00e0 kh\u00f4ng y\u1ebfu li\u1ec7t tay ch\u00e2n.",
        "confidence": 1.0,
        "audio_span": {
            "start_time": 27.2,
            "end_time": 32.0
        },
        "created_at": "2026-06-02T00:00:00+07:00",
        "version": "v0.1.0"
    },
    {
        "segment_id": "seg_009",
        "encounter_id": "SYN_OUT_003",
        "start_time": 32.1,
        "end_time": 34.3,
        "speaker_id": "Speaker_0",
        "speaker_role": "doctor",
        "text": "G\u1ea7n \u0111\u00e2y anh ng\u1ee7 th\u1ebf n\u00e0o?",
        "confidence": 1.0,
        "audio_span": {
            "start_time": 32.1,
            "end_time": 34.3
        },
        "created_at": "2026-06-02T00:00:00+07:00",
        "version": "v0.1.0"
    },
    {
        "segment_id": "seg_010",
        "encounter_id": "SYN_OUT_003",
        "start_time": 34.4,
        "end_time": 38.7,
        "speaker_id": "Speaker_1",
        "speaker_role": "patient",
        "text": "Em ng\u1ee7 k\u00e9m, m\u1ed7i \u0111\u00eam ch\u1ec9 kho\u1ea3ng b\u1ed1n \u0111\u1ebfn n\u0103m ti\u1ebfng.",
        "confidence": 1.0,
        "audio_span": {
            "start_time": 34.4,
            "end_time": 38.7
        },
        "created_at": "2026-06-02T00:00:00+07:00",
        "version": "v0.1.0"
    },
    {
        "segment_id": "seg_011",
        "encounter_id": "SYN_OUT_003",
        "start_time": 38.8,
        "end_time": 42.0,
        "speaker_id": "Speaker_0",
        "speaker_role": "doctor",
        "text": "Anh c\u00f3 u\u1ed1ng nhi\u1ec1u c\u00e0 ph\u00ea ho\u1eb7c th\u1ee9c khuya kh\u00f4ng?",
        "confidence": 1.0,
        "audio_span": {
