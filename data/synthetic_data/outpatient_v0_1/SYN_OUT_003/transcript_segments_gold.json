    },
    {
        "segment_id": "seg_002",
        "encounter_id": "SYN_OUT_003",
        "start_time": 3.3,
        "end_time": 6.5,
        "speaker_id": "Speaker_1",
        "speaker_role": "patient",
        "text": "D\u1ea1 em b\u1ecb \u0111au \u0111\u1ea7u kho\u1ea3ng m\u1ed9t tu\u1ea7n nay.",
        "confidence": 1.0,
        "audio_span": {
