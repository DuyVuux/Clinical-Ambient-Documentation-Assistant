        "version": "v0.1.0"
    },
    {
        "segment_id": "seg_012",
        "encounter_id": "SYN_OUT_003",
        "start_time": 42.1,
        "end_time": 46.5,
        "speaker_id": "Speaker_1",
        "speaker_role": "patient",
        "text": "D\u1ea1 em hay u\u1ed1ng c\u00e0 ph\u00ea bu\u1ed5i t\u1ed1i v\u00e0 l\u00e0m vi\u1ec7c m\u00e1y t\u00ednh kh\u00e1 khuya.",
        "confidence": 1.0,
        "audio_span": {
            "start_time": 42.1,
            "end_time": 46.5
        },
        "created_at": "2026-06-02T00:00:00+07:00",
        "version": "v0.1.0"
    },
    {
        "segment_id": "seg_013",
        "encounter_id": "SYN_OUT_003",
        "start_time": 46.6,
        "end_time": 52.0,
        "speaker_id": "Speaker_0",
        "speaker_role": "doctor",
        "text": "Anh c\u00f3 b\u1ecb co gi\u1eadt, ng\u1ea5t ho\u1eb7c \u0111au \u0111\u1ea7u d\u1eef d\u1ed9i nh\u1ea5t t\u1eeb tr\u01b0\u1edbc \u0111\u1ebfn nay kh\u00f4ng?",
        "confidence": 1.0,
        "audio_span": {
            "start_time": 46.6,
            "end_time": 52.0
        },
        "created_at": "2026-06-02T00:00:00+07:00",
