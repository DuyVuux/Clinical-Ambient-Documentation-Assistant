    },
    {
        "segment_id": "seg_015",
        "encounter_id": "SYN_OUT_003",
        "start_time": 57.1,
        "end_time": 72.8,
        "speaker_id": "Speaker_0",
        "speaker_role": "doctor",
        "text": "Tr\u01b0\u1edbc m\u1eaft anh n\u00ean ngh\u1ec9 ng\u01a1i, gi\u1ea3m c\u00e0 ph\u00ea bu\u1ed5i t\u1ed1i, h\u1ea1n ch\u1ebf th\u1ee9c khuya v\u00e0 theo d\u00f5i m\u1ee9c \u0111\u1ed9 \u0111au \u0111\u1ea7u. N\u1ebfu \u0111au \u0111\u1ea7u d\u1eef d\u1ed9i, y\u1ebfu li\u1ec7t, n\u00f3i kh\u00f3, nh\u00ecn m\u1edd, co gi\u1eadt ho\u1eb7c ng\u1ea5t th\u00ec c\u1ea7n \u0111i kh\u00e1m ngay.",
        "confidence": 1.0,
        "audio_span": {
            "start_time": 57.1,
