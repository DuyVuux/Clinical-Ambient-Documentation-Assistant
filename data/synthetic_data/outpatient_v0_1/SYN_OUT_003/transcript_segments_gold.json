        "start_time": 0.0,
        "end_time": 3.2,
        "speaker_id": "Speaker_0",
        "speaker_role": "doctor",
        "text": "Ch\u00e0o anh, h\u00f4m nay anh \u0111i kh\u00e1m v\u00ec v\u1ea5n \u0111\u1ec1 g\u00ec?",
        "confidence": 1.0,
        "audio_span": {
