        "end_time": 14.2,
        "speaker_id": "Speaker_1",
        "speaker_role": "patient",
        "text": "Em \u0111au quanh r\u1ed1n, \u0111au t\u1eebng c\u01a1n ch\u1ee9 kh\u00f4ng \u0111au li\u00ean t\u1ee5c.",
